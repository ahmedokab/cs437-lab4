{
  "RecipeFormatVersion": "2020-01-25",
  "ComponentName": "com.lab4.EmissionProcessor",
  "ComponentVersion": "1.0.0",
  "ComponentDescription": "Computes running max CO2 per vehicle and returns it to that vehicle",
  "ComponentPublisher": "Okab",
  "ComponentConfiguration": {
    "DefaultConfiguration": {
      "accessControl": {
        "aws.greengrass.ipc.pubsub": {
          "com.lab4.EmissionProcessor:pubsub:1": {
            "policyDescription": "Subscribe to vehicle data, publish vehicle results",
            "operations": [
              "aws.greengrass#SubscribeToTopic",
              "aws.greengrass#PublishToTopic"
            ],
            "resources": ["*"]
          }
        }
      }
    }
  },
  "Manifests": [
    {
      "Platform": { "os": "linux" },
      "Lifecycle": {
        "run": "python3 -u {artifacts:path}/process_emission.py"
      }
    }
  ]
}
