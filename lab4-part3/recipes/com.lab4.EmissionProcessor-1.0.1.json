{
  "RecipeFormatVersion": "2020-01-25",
  "ComponentName": "com.lab4.EmissionProcessor",
  "ComponentVersion": "1.0.1",
  "ComponentDescription": "Computes running max CO2 per vehicle, returns it to that vehicle, and archives readings to Firehose",
  "ComponentPublisher": "Okab",
  "ComponentDependencies": {
    "aws.greengrass.TokenExchangeService": {
      "VersionRequirement": ">=2.0.0",
      "DependencyType": "HARD"
    }
  },
  "ComponentConfiguration": {
    "DefaultConfiguration": {
      "accessControl": {
        "aws.greengrass.ipc.pubsub": {
          "com.lab4.EmissionProcessor:pubsub:1": {
            "policyDescription": "Subscribe to vehicle data, publish vehicle results",
            "operations": [
              "aws.greengrass#SubscribeToTopic",
              "aws.greengrass#PublishToTopic"
            ],
            "resources": ["*"]
          }
        }
      }
    }
  },
  "Manifests": [
    {
      "Platform": { "os": "linux" },
      "Lifecycle": {
        "install": "python3 -m pip install --user awsiotsdk boto3",
        "run": "python3 -u {artifacts:path}/process_emission.py"
      }
    }
  ]
}
